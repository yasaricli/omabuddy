pkgname=omabuddy
pkgver=0.1.0
pkgrel=1
pkgdesc='A pixel buddy who walks your screen and keeps an eye on Claude Code'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omabuddy "$pkgdir/usr/bin/omabuddy"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omabuddy.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omabuddy.svg"
  install -Dm644 "$startdir/omabuddy.desktop" "$pkgdir/usr/share/applications/omabuddy.desktop"
}
